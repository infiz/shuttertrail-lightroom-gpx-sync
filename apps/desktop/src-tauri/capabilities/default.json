{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions required by the ShutterTrail desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://infiz.github.io/shuttertrail-pages/" },
        { "url": "https://apps.apple.com/us/app/shutter-trail/id6792596736" }
      ]
    }
  ]
}
